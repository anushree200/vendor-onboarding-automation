# Select gemini, openai, or anthropic. No external calls occur without an API key.
LLM_PROVIDER=gemini
LLM_API_KEY=
# Optional override; defaults depend on LLM_PROVIDER.
# LLM_MODEL=

# For Streamlit Community Cloud, add the same settings in the app's Secrets UI.
APP_PASSWORD=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
