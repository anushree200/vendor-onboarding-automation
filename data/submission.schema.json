{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vendor submission",
  "description": "Required fields for a vendor onboarding submission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "company_name",
    "country",
    "tax_id",
    "registered_address",
    "contact_name",
    "contact_email",
    "bank_account_holder",
    "bank_name",
    "bank_account_number",
    "bank_country",
    "ifsc_or_routing",
    "documents"
  ],
  "properties": {
    "company_name": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "type": "string",
      "enum": ["IN", "US", "GB", "DE"]
    },
    "tax_id": {
      "type": "string",
      "minLength": 1
    },
    "registered_address": {
      "type": "string",
      "minLength": 1
    },
    "contact_name": {
      "type": "string",
      "minLength": 1
    },
    "contact_email": {
      "type": "string",
      "format": "email"
    },
    "bank_account_holder": {
      "type": "string",
      "minLength": 1
    },
    "bank_name": {
      "type": "string",
      "minLength": 1
    },
    "bank_account_number": {
      "type": "string",
      "minLength": 1
    },
    "bank_country": {
      "type": "string",
      "enum": ["IN", "US", "GB", "DE"]
    },
    "ifsc_or_routing": {
      "type": "string",
      "minLength": 1
    },
    "documents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "incorporation_cert",
          "tax_registration",
          "bank_proof",
          "w9_or_w8"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "country": { "const": "IN" }
        },
        "required": ["country"]
      },
      "then": {
        "properties": {
          "tax_id": {
            "type": "string",
            "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$"
          },
          "bank_country": { "const": "IN" },
          "bank_account_number": {
            "type": "string",
            "pattern": "^[0-9]{9,18}$"
          },
          "ifsc_or_routing": {
            "type": "string",
            "pattern": "^[A-Z]{4}0[A-Z0-9]{6}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "country": { "const": "US" }
        },
        "required": ["country"]
      },
      "then": {
        "properties": {
          "bank_country": { "const": "US" },
          "bank_account_number": {
            "type": "string",
            "pattern": "^[0-9]{4,17}$"
          },
          "ifsc_or_routing": {
            "type": "string",
            "pattern": "^[0-9]{9}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "country": { "const": "GB" }
        },
        "required": ["country"]
      },
      "then": {
        "properties": {
          "bank_country": { "const": "GB" },
          "bank_account_number": {
            "type": "string",
            "pattern": "^GB[0-9]{2}[A-Z]{4}[0-9]{14}$"
          },
          "ifsc_or_routing": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "country": { "const": "DE" }
        },
        "required": ["country"]
      },
      "then": {
        "properties": {
          "bank_country": { "const": "DE" },
          "bank_account_number": {
            "type": "string",
            "pattern": "^DE[0-9]{20}$"
          },
          "ifsc_or_routing": {
            "type": "string",
            "pattern": "^[A-Z]{8}([A-Z0-9]{3})?$"
          }
        }
      }
    }
  ]
}
